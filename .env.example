# Copy this file to .env and fill in your keys:  cp .env.example .env
# .env is listed in .gitignore, so your real keys are never committed.
# (You can use .streamlit/secrets.toml instead - same names. See secrets.toml.example.)

# Required (free) - Discogs personal access token:
# log in at discogs.com -> Settings -> Developers -> "Generate new token"
DISCOGS_TOKEN=

# Optional: currency for Discogs prices (default USD)
# DISCOGS_CURRENCY=USD

# Optional (free) - eBay listings for the Deal Finder:
# developer.ebay.com -> Application Keys -> create a Production keyset
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Optional: your ZIP code, so eBay can include shipping costs to you
# EBAY_ZIP=

# Optional (free) - Last.fm "similar artists" for Discover recommendations:
# last.fm/api/account/create -> copy the "API key"
LASTFM_API_KEY=

# Optional (free) - Spotify login for Discover (your top artists and tracks):
# developer.spotify.com/dashboard -> Create app -> Redirect URI http://127.0.0.1:8501/discover, tick Web API
SPOTIFY_CLIENT_ID=
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8501/discover

# Optional: contact for MusicBrainz's User-Agent (they ask apps to include one)
# MUSICBRAINZ_CONTACT=

# Optional, PAID (off by default): Claude rewrites recommendation reasons in friendlier words.
# Leave empty to keep everything free; rule-based reasons are used instead.
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
